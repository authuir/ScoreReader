# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle
.gradle/
build/

# Local configuration file
local.properties

# Proguard folder
proguard/

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Captures
captures/

# Keystore (never commit signing keys)
*.jks
*.keystore

# Babel transpile workspace
tools/transpile/node_modules/
tools/transpile/package-lock.json

# Vendored third-party sources: we check in the source zip under `vendor/`,
# but the extracted tree is treated as a build artifact (recreated by the
# unzip step in the README). Keep the zip, ignore the extracted folder.
vendor/verovio-version-6.1.0/

# Native C++ build cache produced by AGP's externalNativeBuild (per-ABI
# .o files, ninja files, generated headers). Regenerated on every build.
.cxx/
app/.cxx/

# Local build logs (Tee-Object output from gradlew runs).
build-*.log

# Online library: keep tooling + library.json tracked, but don't commit the
# third-party score binaries themselves. Re-run online-library/download_library.py
# to regenerate the local mirror.
online-library/scores/

# Online library (Pages deployment): only the user-uploaded *.mxl files in
# online-library/public/scores/ are tracked. library.json and index.html
# are regenerated by .github/workflows/online-library-pages.yml on every
# deploy, so we don't keep them in git to avoid merge churn.
online-library/public/library.json
online-library/public/index.html

