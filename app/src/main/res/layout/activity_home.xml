<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/toolbar_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/engine_webview"
            android:focusable="true"
            android:nextFocusRight="@+id/btnOpen"
            android:nextFocusDown="@+id/recyclerRecents" />

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_open"
            android:focusable="true"
            android:nextFocusLeft="@id/btnEngine"
            android:nextFocusRight="@+id/btnScan"
            android:nextFocusDown="@+id/recyclerRecents" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_scan"
            android:focusable="true"
            android:nextFocusLeft="@id/btnOpen"
            android:nextFocusDown="@+id/recyclerRecents" />
    </LinearLayout>

    <TextView
        android:id="@+id/sectionRecents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/section_recents"
        android:textColor="#FFCCCCCC"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:padding="32dp"
        android:gravity="center"
        android:text="@string/empty_recents"
        android:textColor="#FF888888"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/sectionRecents" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toBottomOf="@id/sectionRecents"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
