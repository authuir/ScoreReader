<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon tint for the home-screen icon buttons. When the button is focused
    or pressed (filled accent oval background), the icon flips to white for
    contrast. Otherwise it follows the day/night `text_primary` token.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="#FFFFFFFF" />
    <item android:state_focused="true" android:color="#FFFFFFFF" />
    <item android:color="@color/text_primary" />
</selector>
