<?xml version="1.0" encoding="utf-8"?>
<!--
    Background color for recent score cards. When the card is focused via
    DPAD (or pressed via touch) we shift to a noticeably lighter surface
    so a user across the room can immediately tell which item is
    highlighted. Day/night variants live in values{,-night}/colors.xml.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/card_surface_pressed" />
    <item android:state_focused="true" android:color="@color/card_surface_focused" />
    <item android:state_selected="true" android:color="@color/card_surface_focused" />
    <item android:color="@color/card_surface" />
</selector>
